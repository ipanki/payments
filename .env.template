# Application
APP_API_KEY=change-me-secret-key
APP_DEBUG=false
APP_OUTBOX_POLL_INTERVAL=2.0

# Database
DB_HOST=postgres
DB_PORT=5432
DB_USER=payments
DB_PASSWORD=payments
DB_NAME=payments
DB_POOL_SIZE=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true

# RabbitMQ
RABBITMQ_URL=amqp://payments:payments@rabbitmq:5672/

# Consumer
CONSUMER_MAX_RETRIES=3
CONSUMER_BASE_DELAY_SECONDS=5
CONSUMER_WEBHOOK_MAX_ATTEMPTS=3
CONSUMER_WEBHOOK_RETRY_MIN_WAIT=2.0
CONSUMER_WEBHOOK_RETRY_MAX_WAIT=8.0
